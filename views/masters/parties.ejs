<%- include('../partials/head', { title: type === 'vendor' ? 'Vendors' : 'Customers' }) %>
<%- include('../partials/nav') %>
<div class="container">
  <div class="tabs">
    <a href="/masters/parties?type=customer" class="<%= type === 'customer' ? 'active' : '' %>">Customers</a>
    <a href="/masters/parties?type=vendor" class="<%= type === 'vendor' ? 'active' : '' %>">Vendors</a>
  </div>
  <h1><%= type === 'vendor' ? 'Vendor Master' : 'Customer Master' %></h1>

  <div class="grid cols-2">
    <div class="card">
      <h3>Add <%= type %></h3>
      <form method="POST" action="/masters/parties">
        <%- include('../partials/csrf') %>
        <input type="hidden" name="type" value="<%= type %>">
        <label>Name</label>
        <input class="editable" name="name" required>
        <label>GSTIN (leave blank if unregistered)</label>
        <input class="editable" name="gstin" id="partyGstin" maxlength="15">
        <label>Address</label>
        <textarea class="editable" name="address" rows="2"></textarea>
        <label>State</label>
        <select class="editable" name="stateCode" id="partyState">
          <% STATE_CODES.forEach(s => { %><option value="<%= s.code %>"><%= s.code %> — <%= s.name %></option><% }) %>
        </select>
        <div class="checkbox-row"><input type="checkbox" name="isRegistered" id="isRegistered"><label for="isRegistered" style="margin:0">Registered under GST</label></div>
        <div class="actions"><button class="btn" type="submit">Save</button></div>
      </form>
    </div>

    <div class="card">
      <form method="GET" style="display:flex;gap:10px;align-items:flex-end;margin-bottom:12px">
        <input type="hidden" name="type" value="<%= type %>">
        <div style="flex:1"><label>Search by name</label><input name="q" value="<%= q %>" placeholder="Type to filter..."></div>
        <div class="checkbox-row" style="margin-top:0"><input type="checkbox" name="showInactive" id="showInactive" <%= showInactive ? 'checked' : '' %>><label for="showInactive" style="margin:0">Show inactive</label></div>
        <button class="btn secondary small" type="submit">Filter</button>
      </form>
      <h3><%= parties.length %> <%= type %>(s)</h3>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Name</th><th>GSTIN</th><th>State</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% parties.forEach(p => { %>
              <tr style="<%= p.active === false ? 'opacity:.55' : '' %>">
                <td><%= p.name %></td>
                <td><%= p.gstin || '—' %></td>
                <td><%= nameForCode(p.stateCode) %></td>
                <td>
                  <% if (p.isRegistered) { %><span class="badge ok">Registered</span><% } else { %><span class="badge muted">Unregistered</span><% } %>
                  <% if (p.active === false) { %><span class="badge danger">Inactive</span><% } %>
                </td>
                <td style="white-space:nowrap">
                  <a class="btn secondary small" href="/masters/parties/<%= p.id %>/edit">Edit</a>
                  <form method="POST" action="/masters/parties/<%= p.id %>/toggle-active" style="display:inline">
                    <%- include('../partials/csrf') %>
                    <button class="btn <%= p.active === false ? '' : 'danger' %> small" type="submit"><%= p.active === false ? 'Reactivate' : 'Deactivate' %></button>
                  </form>
                </td>
              </tr>
            <% }) %>
            <% if (!parties.length) { %><tr><td colspan="5">None found.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<script src="/js/partyAutofill.js"></script>
<%- include('../partials/foot') %>
