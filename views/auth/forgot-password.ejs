<%- include('../partials/head', { title: 'Forgot password' }) %>
<div class="login-wrap">
  <div class="card login-card">
    <h1>Forgot password</h1>
    <p class="subtitle">We'll send a reset link to your email if an account exists.</p>
    <% if (sent) { %>
      <div class="banner ok">If that email has an account, a reset link has been sent. (In this environment with no email provider configured, the link is printed to the server console/log instead — see README.)</div>
    <% } else { %>
      <% if (error) { %><div class="banner danger"><%= error %></div><% } %>
      <form method="POST" action="/forgot-password">
        <%- include('../partials/csrf') %>
        <label>Email</label>
        <input class="editable" type="email" name="email" required autofocus>
        <div class="actions"><button class="btn" type="submit" style="width:100%">Send reset link</button></div>
      </form>
    <% } %>
    <p style="text-align:center;font-size:13px;margin-top:14px"><a href="/login">Back to login</a></p>
  </div>
</div>
<%- include('../partials/foot') %>
