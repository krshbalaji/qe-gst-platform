<%- include('../partials/head', { title: 'Reset password' }) %>
<div class="login-wrap">
  <div class="card login-card">
    <h1>Reset password</h1>
    <% if (invalid) { %>
      <div class="banner danger">This reset link is invalid or has expired. Request a new one.</div>
      <p style="text-align:center;font-size:13px;margin-top:14px"><a href="/forgot-password">Request a new link</a></p>
    <% } else { %>
      <% if (error) { %><div class="banner danger"><%= error %></div><% } %>
      <form method="POST" action="/reset-password/<%= token %>">
        <%- include('../partials/csrf') %>
        <label>New password (at least 8 characters)</label>
        <input class="editable" type="password" name="password" minlength="8" required autofocus>
        <div class="actions"><button class="btn" type="submit" style="width:100%">Set new password</button></div>
      </form>
    <% } %>
  </div>
</div>
<%- include('../partials/foot') %>
