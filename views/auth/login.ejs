<%- include('../partials/head', { title: 'Log in' }) %>
<div class="login-wrap">
  <div class="card login-card">
    <h1>QE3 GST Platform</h1>
    <p class="subtitle">Sign in to continue</p>
    <% if (typeof reset !== 'undefined' && reset) { %><div class="banner ok">Password updated — log in with your new password.</div><% } %>
    <% if (error) { %><div class="banner danger"><%= error %></div><% } %>
    <form method="POST" action="/login">
      <%- include('../partials/csrf') %>
      <label>Email</label>
      <input type="email" name="email" required autofocus>
      <label>Password</label>
      <input type="password" name="password" required>
      <div class="actions"><button class="btn" type="submit" style="width:100%">Log in</button></div>
    </form>
    <p style="text-align:center;font-size:13px;margin-top:14px">
      <a href="/forgot-password">Forgot password?</a> &nbsp;·&nbsp; <a href="/signup">Register a new business</a>
    </p>
    <div class="demo-creds">
      <strong>Demo accounts</strong> (after running <code>npm run seed</code>):<br>
      owner@aravindtextiles.example / owner123 — full access<br>
      accountant@aravindtextiles.example / accountant123 — full access<br>
      ca@rameshandco.example / ca123 — read-only (CA / client access)<br>
      viewer@aravindtextiles.example / viewer123 — read-only
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
