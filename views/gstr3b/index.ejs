<%- include('../partials/head', { title: 'GSTR-3B' }) %>
<%- include('../partials/nav') %>
<div class="container">
  <h1>GSTR-3B — Summary Return</h1>
  <p class="subtitle">Outward liability is auto-drafted from GSTR-1 data; ITC is pulled from the Purchase Register. Review and record what you actually claim before locking the period.</p>

  <div class="filter-bar">
    <form method="GET" style="display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end">
      <div><label>Period</label><input type="month" name="period" value="<%= period %>"></div>
      <div><button class="btn secondary" type="submit">Load</button></div>
    </form>
    <div style="margin-left:auto"><a class="btn secondary" href="/gstr3b/export.csv?period=<%= period %>">⬇ Export CSV</a></div>
  </div>

  <% if (locked) { %><div class="banner ok">This period is locked. No further edits are permitted (mirrors the GST portal's post-filing lock).</div><% } %>

  <div class="grid cols-2">
    <div class="card">
      <h3>3.1 Outward supplies &amp; tax liability (auto-drafted)</h3>
      <table>
        <tr><td>Taxable value</td><td class="num calc">₹<%= outward.taxableValue.toLocaleString('en-IN') %></td></tr>
        <tr><td>IGST</td><td class="num calc" id="liabIgst" data-value="<%= outward.igst %>">₹<%= outward.igst.toLocaleString('en-IN') %></td></tr>
        <tr><td>CGST</td><td class="num calc" id="liabCgst" data-value="<%= outward.cgst %>">₹<%= outward.cgst.toLocaleString('en-IN') %></td></tr>
        <tr><td>SGST</td><td class="num calc" id="liabSgst" data-value="<%= outward.sgst %>">₹<%= outward.sgst.toLocaleString('en-IN') %></td></tr>
      </table>
    </div>
    <div class="card">
      <h3>ITC available from purchase register</h3>
      <table>
        <tr><td>IGST</td><td class="num calc">₹<%= itcAvailable.igst.toLocaleString('en-IN') %></td></tr>
        <tr><td>CGST</td><td class="num calc">₹<%= itcAvailable.cgst.toLocaleString('en-IN') %></td></tr>
        <tr><td>SGST</td><td class="num calc">₹<%= itcAvailable.sgst.toLocaleString('en-IN') %></td></tr>
      </table>
    </div>
  </div>

  <div class="card">
    <h3>ITC claimed this period</h3>
    <form method="POST" action="/gstr3b" id="gstr3bForm">
      <%- include('../partials/csrf') %>
      <input type="hidden" name="period" value="<%= period %>">
      <div class="grid cols-3">
        <div><label>IGST claimed (₹)</label><input class="editable" id="claimedIgst" type="number" step="0.01" min="0" name="itcClaimedIgst" value="<%= saved ? saved.itcClaimed.igst : itcAvailable.igst %>" <%= locked ? 'readonly' : '' %>></div>
        <div><label>CGST claimed (₹)</label><input class="editable" id="claimedCgst" type="number" step="0.01" min="0" name="itcClaimedCgst" value="<%= saved ? saved.itcClaimed.cgst : itcAvailable.cgst %>" <%= locked ? 'readonly' : '' %>></div>
        <div><label>SGST claimed (₹)</label><input class="editable" id="claimedSgst" type="number" step="0.01" min="0" name="itcClaimedSgst" value="<%= saved ? saved.itcClaimed.sgst : itcAvailable.sgst %>" <%= locked ? 'readonly' : '' %>></div>
      </div>
      <% if (!locked) { %>
      <div class="checkbox-row"><input type="checkbox" name="lock" id="lock"><label for="lock" style="margin:0">Lock this period after filing (irreversible in this demo)</label></div>
      <div class="actions"><button class="btn" type="submit">Save</button></div>
      <% } %>
    </form>
  </div>

  <div class="card">
    <h3>Net cash tax payable (after ITC set-off)</h3>
    <p class="subtitle" style="margin-top:-6px">Applies the standard set-off order: IGST credit → IGST, then CGST, then SGST liability; CGST credit → CGST then leftover IGST; SGST credit → SGST then leftover IGST. CGST and SGST credit can never offset each other.</p>
    <table>
      <thead><tr><th></th><th class="num">IGST</th><th class="num">CGST</th><th class="num">SGST</th><th class="num">Total</th></tr></thead>
      <tbody>
        <tr><td>Net payable in cash</td><td class="num calc" id="payIgst">—</td><td class="num calc" id="payCgst">—</td><td class="num calc" id="paySgst">—</td><td class="num calc" id="payTotal">—</td></tr>
        <tr><td>Closing (unutilized) ITC balance</td><td class="num" id="closeIgst">—</td><td class="num" id="closeCgst">—</td><td class="num" id="closeSgst">—</td><td></td></tr>
      </tbody>
    </table>
  </div>
</div>
<script src="/js/gstr3bCalc.js"></script>
<%- include('../partials/foot') %>
