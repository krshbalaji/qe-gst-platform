# Copy this file to .env and fill in real values before deploying to production.
# In local dev, you don't need to do anything -- server.js/seed.js auto-generate a
# real .env with random secrets on first run (see lib/ensureEnv.js) and reuse it on
# every subsequent run. In production, that auto-generation is deliberately disabled
# (container filesystems are often ephemeral) -- set these via your platform's real
# secret management instead.

# Required in production: a long random string, used to sign session cookies.
SESSION_SECRET=

# Required in production: a 64-character hex string (32 bytes), used to encrypt PAN
# and bank-details fields at rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACK THIS UP. If you lose it, every already-encrypted PAN/bank-details value becomes
# permanently unreadable (there is no recovery path by design -- that's what "the key
# encrypts the data" means).
ENCRYPTION_KEY=

PORT=4000

# development | production -- controls whether error pages show stack traces, whether
# the session cookie requires HTTPS, and whether ensureEnv() will auto-write a .env
NODE_ENV=development
